<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1127_unknown,">
  <rule id="101705" level="9">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.sourceImage">\ttdinject\.exe$</field>
    <description>Sigma: Remote Thread Creation Ttdinject.exe Proxy</description>
    <mitre>
      <id>T1127</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="102132" level="10">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.image">\ArcSOC\.exe$</field>
    <field name="win.eventdata.targetFilename">\.ahk$|\.aspx$|\.au3$|\.bat$|\.cmd$|\.dll$|\.exe$|\.hta$|\.js$|\.ps1$|\.py$|\.vbe$|\.vbs$|\.wsf$</field>
    <description>Sigma: Suspicious File Created by ArcSOC.exe</description>
    <mitre>
      <id>T1127</id>
      <id>T1105</id>
      <id>T1133</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
  <rule id="101835" level="9">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.image">\msbuild\.exe$</field>
    <field name="win.eventdata.destinationPort">80|443</field>
    <field name="win.eventdata.initiated">true</field>
    <description>Sigma: Silenttrinity Stager Msbuild Activity</description>
    <mitre>
      <id>T1127</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101981" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">\calc\.exe$|\notepad\.exe$</field>
    <field name="win.eventdata.parentImage">\aspnet_compiler\.exe$</field>
    <description>Sigma: Suspicious Child Process of AspNetCompiler</description>
    <mitre>
      <id>T1127</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101982" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">\aspnet_compiler\.exe$</field>
    <field name="win.eventdata.commandLine">\Users\Public\|\AppData\Local\Temp\|\AppData\Local\Roaming\|:\Temp\|:\Windows\Temp\|:\Windows\System32\Tasks\|:\Windows\Tasks\</field>
    <description>Sigma: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler</description>
    <mitre>
      <id>T1127</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
</group>
