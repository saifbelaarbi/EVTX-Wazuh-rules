      <id>T1552.006</id>
    </mitre>
    <group>credential_access,sigma_converted,</group>
  </rule>
  <rule id="110275" level="11">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">\SYSVOL\|\policies\</field>
