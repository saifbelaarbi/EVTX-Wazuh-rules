<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1203_unknown,">
  <rule id="100023" level="9">
    <if_sid>60003</if_sid>
    <field name="win.eventdata.provider_Name">Microsoft-Windows-Audit-CVE|Audit-CVE</field>
    <field name="win.system.eventID">1</field>
    <description>Sigma: Audit CVE Event</description>
    <mitre>
      <id>T1203</id>
      <id>T1068</id>
      <id>T1211</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="100228" level="9">
