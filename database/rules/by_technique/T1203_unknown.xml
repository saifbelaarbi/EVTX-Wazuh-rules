    <field name="win.eventdata.image">\\eqnedt32.exe$</field>
    <description>Sigma: Network Connection Initiated By Eqnedt32.EXE</description>
    <mitre>
      <id>T1203</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="100229" level="8">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.image">\\excel.exe$|\\outlook.exe$|\\powerpnt.exe$|\\winword.exe$|\\wordview.exe$</field>
    <field name="win.eventdata.initiated">true</field>
