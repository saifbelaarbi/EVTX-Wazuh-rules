    <field name="win.eventdata.commandLine">jre1.|jdk1.</field>
    <description>Sigma: Java Running with Remote Debugging</description>
    <mitre>
      <id>T1203</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="100896" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage">\\spoolsv.exe$</field>
    <field name="win.eventdata.integrityLevel">System|S-1-16-16384</field>
    <description>Sigma: Suspicious Spool Service Child Process</description>
    <mitre>
      <id>T1203</id>
      <id>T1068</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101038" level="8">
