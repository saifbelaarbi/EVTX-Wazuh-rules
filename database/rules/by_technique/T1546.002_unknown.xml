<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1546.002_unknown,">
  <rule id="104711" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">\\reg.exe$</field>
    <field name="win.eventdata.commandLine">/v ScreenSaveActive|/t REG_SZ|/d 1|/f</field>
    <description>Sigma: Suspicious ScreenSave Change by Reg.exe</description>
    <mitre>
      <id>T1546.002</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
  <rule id="104762" level="9">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject">\\Control Panel\\Desktop\\SCRNSAVE.EXE$</field>
    <description>Sigma: Path To Screensaver Binary Modified</description>
    <mitre>
      <id>T1546.002</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
  <rule id="107049" level="10">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename">.scr$</field>
    <description>Sigma: Suspicious Screensaver Binary File Creation</description>
    <mitre>
      <id>T1546.002</id>
    </mitre>
    <group>privilege_escalation,sigma_converted,</group>
  </rule>
  <rule id="107079" level="10">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename">\\\\\\\\127.0.0|\\ADMIN\$\\</field>
    <description>Sigma: Writing Local Admin Share</description>
    <mitre>
      <id>T1546.002</id>
    </mitre>
    <group>privilege_escalation,sigma_converted,</group>
  </rule>
</group>
