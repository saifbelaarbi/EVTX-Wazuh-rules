<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1564_unknown,">
  <rule id="100176" level="9">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.image">\\colorcpl.exe$</field>
    <description>Sigma: Suspicious Creation with Colorcpl</description>
    <mitre>
      <id>T1564</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="100181" level="9">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename">:\\\$Recycle.Bin.exe$|:\\Documents and Settings.exe$|:\\MSOCache.exe$|:\\PerfLogs.exe$|:\\Recovery.exe$|.bat.exe$|.sys.exe$</field>
    <description>Sigma: Suspicious Executable File Creation</description>
    <mitre>
      <id>T1564</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="100951" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">\\bitsadmin.exe$|\\certutil.exe$|\\cmd.exe$|\\cscript.exe$|\\mshta.exe$|\\powershell.exe$|\\pwsh.exe$|\\regsvr32.exe$|\\rundll32.exe$|\\wscript.exe$</field>
    <field name="win.eventdata.parentImage">:\\Users\\Public\\</field>
    <description>Sigma: Potentially Suspicious Execution From Parent Process In Public Folder</description>
    <mitre>
      <id>T1564</id>
      <id>T1059</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101159" level="9">
    <if_sid>60004</if_sid>
    <field name="win.eventdata.description">Failed to open service configuration with error|Failed to connect to the driver to update configuration</field>
    <description>Sigma: Sysmon Configuration Error</description>
    <mitre>
      <id>T1564</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101160" level="9">
    <if_sid>60004</if_sid>
    <field name="full_log">Sysmon config state changed</field>
    <description>Sigma: Sysmon Configuration Modification</description>
    <mitre>
      <id>T1564</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="101161" level="9">
    <if_sid>60004</if_sid>
    <field name="win.eventdata.state">Stopped</field>
    <description>Sigma: Sysmon Configuration Modification</description>
    <mitre>
      <id>T1564</id>
    </mitre>
    <group>execution,sigma_converted,</group>
  </rule>
  <rule id="104778" level="9">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject">SYSTEM\\CurrentControlSet\\Control\\CrashControl</field>
    <field name="win.eventdata.details">DWORD \(0x00000000\)</field>
    <description>Sigma: CrashControl CrashDump Disabled</description>
    <mitre>
      <id>T1564</id>
      <id>T1112</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
</group>
