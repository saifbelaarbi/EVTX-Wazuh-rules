<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1489_service_stop,">
  <rule id="122005" level="14">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">141|142</field>
    <field name="win.eventdata.taskName">\Windows\SystemRestore\SR|\Windows\Windows Defender\|\Windows\BitLocker|\Windows\WindowsBackup\|\Windows\WindowsUpdate\|\Windows\UpdateOrchestrator\|\Windows\ExploitGuard</field>
    <description>Sigma: Important Scheduled Task Deleted or Disabled</description>
    <mitre>
      <id>T1489</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="122028" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">\Windows\BitLocker|\Windows\ExploitGuard|\Windows\SystemRestore\SR|\Windows\UpdateOrchestrator\|\Windows\Windows Defender\|\Windows\WindowsBackup\|\Windows\WindowsUpdate\</field>
    <field name="win.eventdata.image">\schtasks\.exe$</field>
    <description>Sigma: Delete Important Scheduled Task</description>
    <mitre>
      <id>T1489</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="122029" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine"> /delete |/tn \.*| /f</field>
    <description>Sigma: Delete All Scheduled Tasks</description>
    <mitre>
      <id>T1489</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="122030" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">\Windows\BitLocker|\Windows\ExploitGuard|\Windows\ExploitGuard\ExploitGuard MDM policy Refresh|\Windows\SystemRestore\SR|\Windows\UpdateOrchestrator\|\Windows\Windows Defender\|\Windows\WindowsBackup\|\Windows\WindowsUpdate\</field>
    <field name="win.eventdata.image">\schtasks\.exe$</field>
    <description>Sigma: Disable Important Scheduled Task</description>
    <mitre>
      <id>T1489</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="122035" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine"> delete |\.delete\(\)| pause | stop |Stop-Service |Remove-Service </field>
    <field name="win.eventdata.originalFileName">net\.exe|net1\.exe|PowerShell_ISE\.EXE|PowerShell\.EXE|psservice\.exe|pwsh\.dll|sc\.exe|wmic\.exe</field>
    <description>Sigma: Suspicious Windows Service Tampering</description>
    <mitre>
      <id>T1489</id>
      <id>T1685</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
</group>
