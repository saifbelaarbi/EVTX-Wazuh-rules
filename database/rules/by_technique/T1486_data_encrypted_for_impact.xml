<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1486_data_encrypted_for_impact,">
  <rule id="111001" level="14">
    <if_sid>61609</if_sid>
    <field name="win.eventdata.imageLoaded">\RstrtMgr\.dll$</field>
    <field name="win.eventdata.image">:\Perflogs\|:\Users\Public\|\Temporary Internet</field>
    <description>Sigma: Load Of RstrtMgr.DLL By A Suspicious Process</description>
    <mitre>
      <id>T1486</id>
      <id>T1562</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="111012" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">EnableBDEWithNoTPM|UseAdvancedStartup|UseTPM|UseTPMKey|UseTPMKeyPIN|RecoveryKeyMessageSource|UseTPMPIN|RecoveryKeyMessage|ADD|\SOFTWARE\Policies\Microsoft\FVE|/v|/f</field>
    <description>Sigma: Suspicious Reg Add BitLocker</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
  <rule id="111014" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName">gpg\.exe</field>
    <description>Sigma: Renamed Gpg.EXE Execution</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>impact,sigma_converted,</group>
  </rule>
</group>
