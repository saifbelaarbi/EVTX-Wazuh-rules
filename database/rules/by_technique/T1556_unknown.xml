<?xml version="1.0" encoding="UTF-8"?>
<group name="windows,T1556_unknown,">
  <rule id="102104" level="10">
    <if_sid>60100</if_sid>
    <field name="win.system.eventID">5136</field>
    <field name="win.eventdata.attributeLDAPDisplayName">msDS-KeyCredentialLink</field>
    <description>Sigma: Possible Shadow Credentials Added</description>
    <mitre>
      <id>T1556</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
  <rule id="102187" level="10">
    <if_sid>91801</if_sid>
    <field name="win.eventdata.scriptBlockText">(Copy-Item|cpi) .{2,128} -Destination .{1,32}\\Windows\\(System32|SysWOW64)</field>
    <description>Sigma: Powershell Install a DLL in System Directory</description>
    <mitre>
      <id>T1556</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
  <rule id="102311" level="10">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject">\Control\Lsa\DsrmAdminLogonBehavior$</field>
    <description>Sigma: Directory Service Restore Mode(DSRM) Registry Value Tampering</description>
    <mitre>
      <id>T1556</id>
    </mitre>
    <group>persistence,sigma_converted,</group>
  </rule>
</group>
