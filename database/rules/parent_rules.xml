<!--
  Project-defined parent rules for Windows event channels that the Wazuh
  default ruleset (v4.12) does not classify on its own.

  The "Microsoft-Windows-PowerShell/Operational" and classic "Windows
  PowerShell" channels have NO built-in classifier rule in Wazuh's
  0575-win-base ruleset — its channel chain stops at Sysmon / Windows
  Defender / Windows Firewall (rules 60004/60005/60016). As a result the
  PowerShell detection rules generated by this project (which chain off
  SID 91801, the convention used in rule_builder.py and sigma_analyzer.py)
  had no valid parent to fire from: 91801 does not exist in the default
  ruleset, so the entire PowerShell rule group was silently dropped at
  load time and could never match — neither in live logtest nor on a real
  Windows agent.

  This rule provides that missing parent. It chains off 60000 (the base
  windows eventchannel group), so it fires both in production (events
  arrive via the native windows_eventchannel decoder) and in logtest
  (where the bridge rule overrides 60000 to accept JSON-decoded events).
  SID 91801 is unused by the Wazuh v4.12 default ruleset.
-->
<group name="windows,powershell,">
  <rule id="91801" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-PowerShell/Operational$|^Windows PowerShell$|^PowerShellCore/Operational$</field>
    <options>no_full_log</options>
    <description>Group of Windows PowerShell rules</description>
  </rule>
</group>
