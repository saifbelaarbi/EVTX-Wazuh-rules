<!--
  Project-defined parent rules for Windows event channels.

  Wazuh 4.12 ships rule 91801 (0915-win-powershell_rules.xml), but it only
  matches the "Microsoft-Windows-PowerShell/Operational" channel. This
  project's PowerShell detections (chained off SID 91801 by rule_builder.py
  and sigma_analyzer.py) also cover the classic "Windows PowerShell" and
  "PowerShellCore/Operational" channels, so we OVERWRITE 91801 to widen the
  channel match while preserving its original parents (60000, 60010).

  Plain redefinition would be ignored as a duplicate (Wazuh 7612: "first
  occurrence wins"), silently orphaning classic-channel rules. On older
  Wazuh versions without a built-in 91801 the overwrite falls back to a
  normal load (warning 7613) and still works.
-->
<group name="windows,powershell,">
  <rule id="91801" level="0" overwrite="yes">
    <if_sid>60000, 60010</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-PowerShell/Operational$|^Windows PowerShell$|^PowerShellCore/Operational$</field>
    <options>no_full_log</options>
    <description>Group of Windows PowerShell rules</description>
  </rule>
</group>
